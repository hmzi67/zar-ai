{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZarAI image metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["image_id", "file_path", "crop", "label", "site_id", "district", "date", "growth_stage", "view", "phone_model", "labeller", "expert_verified", "unsure"],
  "properties": {
    "image_id": { "type": "string", "minLength": 1 },
    "file_path": { "type": "string", "minLength": 1 },
    "crop": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "district": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
    "growth_stage": { "type": "string", "minLength": 1 },
    "view": { "enum": ["whole_plant", "leaf_closeup", "leaf_underside"] },
    "phone_model": { "type": "string", "minLength": 1 },
    "labeller": { "type": "string", "minLength": 1 },
    "expert_verified": { "type": "boolean" },
    "unsure": { "type": "boolean" }
  }
}
